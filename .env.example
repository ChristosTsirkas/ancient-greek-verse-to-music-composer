NODE_ENV=production
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5000
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
# Generate a unique, long random value before deployment; do not reuse this example.
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL connection. Keep this .env file on the host; it is read at
# container start and deliberately excluded from the image build. For Docker
# Compose, PGHOST is the database service name, `db`.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_A_STRONG_PASSWORD@db:5432/postgres?sslmode=disable
PGDATABASE=postgres
PGHOST=db
PGPORT=5432
PGUSER=postgres
PGPASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Google authentication setup
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Customer support
GDPR_DPO_EMAIL=my.email.address@gmail.com

# Unlimited usage
EMAIL_ADDRESS_FOR_UNLIMITED_USAGE=my.email.address@gmail.com
